SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://postgres:password@localhost:5432/database

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Used to build links back to the frontend in emails, e.g. an invitation's
# accept link (/invitations/accept/:token).
FRONTEND_URL=http://localhost:5173

# Email (invitation/task-created notifications). Left unset, emails just
# print to the console - fine for local dev. Point these at a real SMTP
# provider (e.g. SendGrid, SES, Mailgun) for actual delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Celery (broker). Result backend is Postgres (django-celery-results), so
# no separate result-store URL is needed. docker-compose overrides this to
# redis://redis:6379/0 for the backend/celery-worker/celery-beat/flower
# services - only change this if running Django/Celery directly on the host.
REDIS_URL=redis://localhost:6379/0

# Basic auth for the Flower dashboard (user:password), e.g. admin:changeme.
# Leave blank to disable auth (fine for local dev only).
FLOWER_BASIC_AUTH=
